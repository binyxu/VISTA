# OpenAI-compatible chat endpoint used by LOCA/SWE wrappers.
LOCA_OPENAI_API_KEY=replace_me
LOCA_OPENAI_BASE_URL=https://api.openai.com/v1

# Some BrowseComp scripts read OpenAI-style names directly.
OPENAI_API_KEY=${LOCA_OPENAI_API_KEY}
OPENAI_BASE_URL=${LOCA_OPENAI_BASE_URL}

# Prototype LLM runner.
LLM_API_KEY=${LOCA_OPENAI_API_KEY}
LLM_BASE_URL=${LOCA_OPENAI_BASE_URL}/chat/completions

